# ============ DeepSeek (LLM) ============
# 必填：你的 DeepSeek API 密钥
DEEPSEEK_API_KEY=sk-xxxxxx
# DeepSeek 兼容 OpenAI 的 base_url，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型：deepseek-chat / deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# 生成参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ============ 人设与陪伴 ============
# professional(专业严谨) / warm_guide(专业+温暖自然) / companion(情感陪伴优先)
PERSONA_TYPE=warm_guide
# 默认用户标识（未指定 user_id 时使用，用于长期记忆）
DEFAULT_USER_ID=default

# ============ 向量嵌入 Embechings ============
# huggingface: 本地模型(默认, 无需密钥)；openai_compatible: 调用远端 Embedding API
EMBEDDING_PROVIDER=huggingface
# huggingface 本地嵌入模型（中文友好）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若 EMBEDDING_PROVIDER=openai_compatible，使用以下配置（与 OpenAI 兼容的 Embedding 服务）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# ============ 检索与切分 ============
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SCORE_THRESHOLD=0.3

# HTTP(S) 代理（如在国内访问 HF 需要代理时填写，示例 http://127.0.0.1:7890）
#HTTPS_PROXY=
#HTTP_PROXY=